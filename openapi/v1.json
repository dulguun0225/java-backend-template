{
  "components" : {
    "headers" : {
      "ETag" : {
        "description" : "Strong ETag, the quoted decimal of the row's version, e.g. \"3\". Never weak.",
        "schema" : {
          "type" : "string"
        }
      }
    },
    "schemas" : {
      "CreateGreetingRequest" : {
        "additionalProperties" : false,
        "properties" : {
          "name" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "GreetingView" : {
        "properties" : {
          "createdAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "Problem" : {
        "properties" : {
          "code" : {
            "description" : "Stable machine code from one of the *ErrorCode catalogs",
            "type" : "string"
          },
          "detail" : {
            "description" : "Caller-safe text, never the value sent. On validation.malformed-body: the line and column where the JSON stopped being well formed, or that the body is missing or not an object",
            "type" : "string"
          },
          "errors" : {
            "description" : "Present only on validation.failed",
            "items" : {
              "properties" : {
                "code" : {
                  "description" : "A FieldCode wire string, e.g. validation.required",
                  "type" : "string"
                },
                "detail" : {
                  "description" : "Caller-safe text naming what was expected, e.g. `expected boolean` on validation.wrong-type; never the value sent. Absent when the code alone says it",
                  "type" : "string"
                },
                "pointer" : {
                  "description" : "RFC 6901 JSON pointer, e.g. /name",
                  "type" : "string"
                }
              },
              "required" : [ "code", "pointer" ],
              "type" : "object"
            },
            "type" : "array"
          },
          "incidentId" : {
            "description" : "Present only on platform.internal (500)",
            "type" : "string"
          },
          "status" : {
            "format" : "int32",
            "type" : "integer"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string"
          }
        },
        "required" : [ "code", "status" ],
        "type" : "object"
      }
    }
  },
  "info" : {
    "title" : "starter",
    "version" : "v1"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/greetings" : {
      "post" : {
        "operationId" : "createGreeting",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateGreetingRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/GreetingView"
                }
              }
            },
            "description" : "Created. `Location` is the new greeting's URL."
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "validation.failed (a field rule, an undeclared member, a wrong JSON type), validation.malformed-body"
          }
        },
        "summary" : "Create one greeting",
        "tags" : [ "greeting-controller" ]
      }
    },
    "/api/greetings/{id}" : {
      "get" : {
        "operationId" : "getGreeting",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/GreetingView"
                }
              }
            },
            "description" : "OK"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "not-found"
          }
        },
        "summary" : "One greeting by its opaque id",
        "tags" : [ "greeting-controller" ]
      }
    }
  }
}
